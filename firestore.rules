rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // sessions: server-only writes, client read only for owner
    match /sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create, update, delete: if false; // admin-only (Admin SDK bypasses rules)
    }

    // audit logs - admin only
    match /auditLogs/{logId} {
      allow read: if false;
      allow write: if false; // admin-only
    }
    
    // Check if user is an admin or superAdmin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superAdmin");
    }

    // Check if user is a superAdmin
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superAdmin";
    }

    // Allow users to read and write only their own bookmark documents
    match /bookmarks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      // Only superAdmins can change roles to admin or superAdmin
      allow update: if request.auth != null &&
                     (
                       // Users can update their own profile but not change their role
                       (request.auth.uid == userId &&
                        (!('role' in request.resource.data) ||
                         request.resource.data.role == resource.data.role))
                       ||
                       // Admins can update user profiles but not change roles to admin or superAdmin
                       (isAdmin() &&
                        (!('role' in request.resource.data) ||
                         request.resource.data.role == resource.data.role))
                       ||
                       // SuperAdmins can change any role
                       isSuperAdmin()
                     );
    }

    // Allow users to read and write their own test results (subcollection under users)
    match /users/{userId}/testResults/{resultId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tests collection - allow authenticated users to read, admins to write
    match /tests/{testId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Allow admins to read and write questions in the questions subcollection
    match /tests/{testId}/questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Bundles collection - allow authenticated users to read live bundles, admins to write
    match /bundles/{bundleId} {
      allow read: if request.auth != null && 
        (resource.data.status == "live" || 
         resource.data.createdBy == request.auth.uid || 
         isAdmin());
      allow write: if isAdmin() || 
        (request.auth != null && 
         resource.data.createdBy == request.auth.uid);
    }

    // Add rules for announcements collection
    match /announcements/{announcementId} {
      // Allow admins and superAdmins to create, read, update, and delete announcements
      allow read, write: if isAdmin() || isSuperAdmin();
    } 

    // Rules for invoices
    match /invoices/{invoiceId} {
      allow read: if request.auth != null && (isSuperAdmin() || get(/databases/$(database)/documents/invoices/$(invoiceId)).data.userId == request.auth.uid);
      allow create: if request.auth != null;
    }

    // Rules for invoice template
    match /invoiceTemplate/default {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    function isManagement() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'management';
    }

    // Rules for payouts
    match /payouts/{payoutId} {
      allow create: if isManagement();
      allow read: if isManagement() || isSuperAdmin() || (isAdmin() && resource.data.adminId == request.auth.uid);
      allow update, delete: if false; // Payouts are immutable
    }

     // Rules for the new coupons collection
    match /coupons/{couponId} {
      // Allow any authenticated user to read a coupon (to verify it)
      allow read: if request.auth != null;
      
      // Only allow users with an 'admin' or 'superAdmin' custom claim to create, update, or delete
      allow write: if isAdmin();
    }


    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}