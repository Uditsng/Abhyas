rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user is an admin or superAdmin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superAdmin");
    }

    // Check if user is a superAdmin
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superAdmin";
    }

    // Allow users to read and write only their own bookmark documents
    match /bookmarks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      // Only superAdmins can change roles to admin or superAdmin
      allow update: if request.auth != null &&
                     (
                       // Users can update their own profile but not change their role
                       (request.auth.uid == userId &&
                        (!('role' in request.resource.data) ||
                         request.resource.data.role == resource.data.role))
                       ||
                       // Admins can update user profiles but not change roles to admin or superAdmin
                       (isAdmin() &&
                        (!('role' in request.resource.data) ||
                         request.resource.data.role == resource.data.role))
                       ||
                       // SuperAdmins can change any role
                       isSuperAdmin()
                     );
    }

    // Allow users to read and write their own test results (subcollection under users)
    match /users/{userId}/testResults/{resultId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

     match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Allow users to read their own subscription
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only admins can write to subscriptions
      allow write: if isAdmin();
    }

    // Tests collection - allow authenticated users to read, admins to write
    match /tests/{testId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Bundles collection - allow authenticated users to read live bundles, admins to write
    match /bundles/{bundleId} {
      allow read: if request.auth != null && 
        (resource.data.status == "live" || 
         resource.data.createdBy == request.auth.uid || 
         isAdmin());
      allow write: if isAdmin() || 
        (request.auth != null && 
         resource.data.createdBy == request.auth.uid);
    }

    // Add rules for announcements collection
    match /announcements/{announcementId} {
      // Allow admins and superAdmins to create, read, update, and delete announcements
      allow read, write: if isAdmin() || isSuperAdmin();
    } 

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}